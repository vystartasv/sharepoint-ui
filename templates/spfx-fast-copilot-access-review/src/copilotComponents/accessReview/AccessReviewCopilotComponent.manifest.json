{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-component-manifest.schema.json",
  "id": "<%= componentId %>",
  "alias": "AccessReviewCopilotComponent",
  "componentType": "CopilotComponent",
  "copilotType": "Ux",
  "version": "*",
  "manifestVersion": 2,

  "capabilities": {
    "availableDisplayModes": ["inline", "fullscreen"]
  },

  "tools": [
    {
      "name": "<%= componentName.pascal %>Tool",
      "description": {
        "default": "<%= componentDescription %>"
      },
      "propertiesSchema": {
        "id": "$../../../lib/copilotComponents/accessReview/AccessReviewCopilotComponentProperties.js:default;"
      }
    }
  ]
}
