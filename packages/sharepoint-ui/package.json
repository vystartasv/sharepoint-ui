{
  "name": "@spfx-fast/sharepoint-ui",
  "version": "0.5.4",
  "license": "MIT",
  "description": "Small themeable React components for SharePoint Framework",
  "homepage": "https://vystartasv.github.io/sharepoint-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vystartasv/sharepoint-ui.git"
  },
  "bugs": {
    "url": "https://github.com/vystartasv/sharepoint-ui/issues"
  },
  "keywords": [
    "sharepoint",
    "spfx",
    "react",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./src/theme.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./components.json": "./components.json",
    "./styles.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "src/theme.css",
    "components.json",
    "measurements.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "react": "18.3.1",
    "typescript": "5.8.3"
  }
}
