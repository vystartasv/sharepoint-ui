{
  "name": "@spfx-fast/sharepoint-ui",
  "version": "0.4.2",
  "license": "MIT",
  "description": "Host-aware, framework-independent UI elements for SharePoint Framework",
  "homepage": "https://vystartasv.github.io/sharepoint-ui-docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vystartasv/sharepoint-ui.git"
  },
  "bugs": {
    "url": "https://github.com/vystartasv/sharepoint-ui/issues"
  },
  "keywords": [
    "sharepoint",
    "spfx",
    "fluent-ui",
    "web-components",
    "react",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "import": "./dist/elements/*.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "import": "./dist/appearance.js"
    },
    "./tokens": "./tokens.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "QUICKSTART.md",
    "AGENTS.md",
    "components.json",
    "tokens.json",
    "skills",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "catalog:check": "node scripts/validate-component-catalog.mjs",
    "catalog:sync-signatures": "node scripts/sync-component-catalog-signatures.mjs",
    "catalog:check-signatures": "node scripts/sync-component-catalog-signatures.mjs --check",
    "tokens:generate": "node scripts/generate-token-index.mjs",
    "tokens:check": "node scripts/generate-token-index.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "^18.3.7",
    "react-dom": "^18.3.1",
    "typescript": "5.8.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
