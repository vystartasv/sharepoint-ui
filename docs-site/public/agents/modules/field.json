{
  "package": "@spfx-fast/sharepoint-ui",
  "module": "field",
  "elementEventInventory": {
    "url": "https://vystartasv.github.io/sharepoint-ui/agents/events/field.json",
    "scope": "source module; composed child tags may also emit listed events"
  },
  "components": [
    {
      "react": "TextField",
      "tag": "spui-field",
      "define": "defineField",
      "module": "field",
      "category": "forms",
      "api": {
        "reactSignature": "inputProps: TextFieldProps",
        "callbackProps": [
          "onValueChange"
        ],
        "slots": [],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Edit a single-line value with an accessible label and controlled change events."
    }
  ]
}
