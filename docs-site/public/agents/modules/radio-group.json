{
  "package": "@spfx-fast/sharepoint-ui",
  "module": "radio-group",
  "components": [
    {
      "react": "RadioGroup",
      "tag": "spui-radio-group",
      "define": "defineRadioGroup",
      "module": "radio-group",
      "category": "forms",
      "api": {
        "reactSignature": "inputProps: RadioGroupProps",
        "callbackProps": [
          "onValueChange",
          "onChange"
        ],
        "slots": [
          "default Radio children"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Choose one value from related radio options with controlled or default state, stacked or horizontal layout, native form participation, validity, reset, and keyboard behavior."
    },
    {
      "react": "Radio",
      "tag": "spui-radio-option",
      "define": "defineRadioGroup",
      "module": "radio-group",
      "category": "forms",
      "registered": false,
      "note": "Option child tag; it is consumed by its parent group and is not separately registered.",
      "api": {
        "reactSignature": "{ value, label, labelPosition, disabled, input, indicator, onChange, children, ...props }: RadioProps",
        "callbackProps": [
          "onChange"
        ],
        "slots": [
          "default",
          "input",
          "indicator"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Define one labelled RadioGroup option with its own label position, disabled state, and selection callback."
    }
  ]
}
