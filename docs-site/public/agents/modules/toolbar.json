        "slots": [
          "default"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Group related commands with one tab stop, arrow-key navigation, optional size, and controlled or default named radio selections.",
      "customElementAttributes": [
        "label",
        "loop",
        "orientation",
        "size",
        "vertical"
      ]
    },
    {
