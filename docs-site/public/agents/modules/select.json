{
  "package": "@spfx-fast/sharepoint-ui",
  "module": "select",
  "elementEventInventory": {
    "url": "https://vystartasv.github.io/sharepoint-ui/agents/events/select.json",
    "scope": "source module; composed child tags may also emit listed events"
  },
  "components": [
    {
      "react": "Select",
      "tag": "spui-select",
      "define": "defineSelect",
      "module": "select",
      "category": "forms",
      "api": {
        "reactSignature": "inputProps: SelectProps",
        "callbackProps": [
          "onValueChange",
          "onChange"
        ],
        "slots": [
          "default option children"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Choose a value from a fixed native option list with browser keyboard behavior, configurable native focus, and tab order.",
      "customElementAttributes": [
        "appearance",
        "aria-describedby",
        "aria-description",
        "aria-invalid",
        "aria-label",
        "aria-labelledby",
        "auto-complete",
        "autofocus",
        "default-value",
        "disabled",
        "form",
        "label",
        "multiple",
        "name",
        "required",
        "size",
        "tabindex",
        "value"
      ]
    }
  ]
}
