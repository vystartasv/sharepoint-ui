{
  "package": "@spfx-fast/sharepoint-ui",
  "module": "card-primitives",
  "elementEventInventory": {
    "url": "https://vystartasv.github.io/sharepoint-ui/agents/events/card-primitives.json",
    "scope": "source module; composed child tags may also emit listed events"
  },
  "components": [
    {
      "react": "CardHeader",
      "tag": "spui-card-header",
      "define": "defineCardHeader",
      "module": "card-primitives",
      "category": "layout",
      "api": {
        "reactSignature": "{ image, header, description, action, children, ...props }: ElementProps & { image?: React.ReactNode; header?: React.ReactNode; description?: React.ReactNode; action?: React.ReactNode }",
        "callbackProps": [],
        "slots": [
          "image",
          "header",
          "description",
          "action",
          "default"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Compose a card identity, title, supporting description, and optional action in a responsive logical-direction header."
    },
    {
      "react": "CardFooter",
      "tag": "spui-card-footer",
      "define": "defineCardFooter",
      "module": "card-primitives",
      "category": "layout",
      "api": {
        "reactSignature": "{ action, children, ...props }: ElementProps & { action?: React.ReactNode }",
        "callbackProps": [],
        "slots": [
          "default",
          "action"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Arrange related card actions in a wrapping footer, with an optional action aligned to the logical end."
    },
    {
      "react": "CardPreview",
      "tag": "spui-card-preview",
      "define": "defineCardPreview",
      "module": "card-primitives",
      "category": "layout",
      "api": {
        "reactSignature": "{ logo, children, ...props }: ElementProps & { logo?: React.ReactNode }",
        "callbackProps": [],
        "slots": [
          "default",
          "logo"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Show an edge-to-edge image, video, or custom SharePoint preview with an optional theme-aware logo overlay."
    }
  ]
}
