{
  "package": "@spfx-fast/sharepoint-ui",
  "module": "search",
  "elementEventInventory": {
    "url": "https://vystartasv.github.io/sharepoint-ui/agents/events/search.json",
    "scope": "source module; composed child tags may also emit listed events"
  },
  "components": [
    {
      "react": "SearchBox",
      "tag": "spui-search-box",
      "define": "defineSearchBox",
      "module": "search",
      "category": "forms",
      "api": {
        "reactSignature": "inputProps: SearchBoxProps",
        "callbackProps": [
          "onValueChange",
          "onSearch",
          "onChange"
        ],
        "slots": [
          "content-before",
          "content-after",
          "dismiss"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Search or filter content with a clear action, native form value, and Enter-to-submit behavior.",
      "customElementAttributes": [
        "appearance",
        "aria-describedby",
        "aria-description",
        "aria-invalid",
        "aria-label",
        "aria-labelledby",
        "aria-required",
        "autocomplete",
        "clear-label",
        "disabled",
        "inputmode",
        "label",
        "maxlength",
        "minlength",
        "name",
        "pattern",
        "placeholder",
        "read-only",
        "required",
        "size",
        "type",
        "value"
      ]
    }
  ]
}
