{
  "package": "@spfx-fast/sharepoint-ui",
  "module": "search",
  "components": [
    {
      "react": "SearchBox",
      "tag": "spui-search-box",
      "define": "defineSearchBox",
      "module": "search",
      "category": "forms",
      "api": {
        "reactSignature": "inputProps: SearchBoxProps",
        "callbackProps": [
          "onValueChange",
          "onSearch",
          "onChange"
        ],
        "slots": [
          "content-before",
          "content-after",
          "dismiss"
