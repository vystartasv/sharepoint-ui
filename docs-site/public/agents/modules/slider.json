{
  "package": "@spfx-fast/sharepoint-ui",
  "module": "slider",
  "elementEventInventory": {
    "url": "https://vystartasv.github.io/sharepoint-ui/agents/events/slider.json",
    "scope": "source module; composed child tags may also emit listed events"
  },
  "components": [
    {
      "react": "Slider",
      "tag": "spui-slider",
      "define": "defineSlider",
      "module": "slider",
      "category": "forms",
      "api": {
        "reactSignature": "inputProps: SliderProps",
        "callbackProps": [
          "onValueChange",
          "onChange"
        ],
        "slots": [
          "input",
          "rail",
          "thumb"
        ],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Choose a numeric value within a range using pointer or keyboard input.",
      "customElementAttributes": [
        "aria-describedby",
        "aria-description",
        "aria-invalid",
        "aria-label",
        "aria-labelledby",
        "aria-orientation",
        "aria-required",
        "aria-valuetext",
        "default-value",
        "disabled",
        "label",
        "max",
        "min",
        "name",
        "size",
        "step",
        "value",
        "vertical"
      ]
    }
  ]
}
