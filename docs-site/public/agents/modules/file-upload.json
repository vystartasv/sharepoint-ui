{
  "package": "@spfx-fast/sharepoint-ui",
  "module": "file-upload",
  "elementEventInventory": {
    "url": "https://vystartasv.github.io/sharepoint-ui/agents/events/file-upload.json",
    "scope": "source module; composed child tags may also emit listed events"
  },
  "components": [
    {
      "react": "FileUpload",
      "tag": "spui-file-upload",
      "define": "defineFileUpload",
      "module": "file-upload",
      "category": "forms",
      "api": {
        "reactSignature": "inputProps: FileUploadProps",
        "callbackProps": [
          "onFilesChange",
          "onFilesError"
        ],
        "slots": [],
        "styling": [
          "SharePointUIProvider tokens",
          "CSS custom properties",
          "host className/style",
          "named ::part hooks"
        ],
        "reactRefType": "HTMLElement"
      },
      "summary": "Select files by browsing or drag and drop, enforce type/count/size constraints, expose accessible removal and events, and contribute selected files to native forms. The consumer owns upload transport and SharePoint persistence.",
      "customElementAttributes": [
        "accept",
        "aria-describedby",
        "aria-description",
        "aria-invalid",
        "aria-label",
        "aria-labelledby",
        "browse-label",
        "disabled",
        "drop-label",
        "invalid-message",
        "label",
        "max-file-size",
        "max-files",
        "multiple",
        "name",
        "remove-label",
        "required",
        "required-message",
        "selected-label"
      ]
    }
  ]
}
