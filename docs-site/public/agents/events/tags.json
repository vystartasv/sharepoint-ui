{
  "module": "tags",
  "scope": "Events are listed by source module because a module can define a parent and its child tags. Check event.target when a module composes multiple tags; detailProperties lists statically declared top-level keys and may be incomplete when detailPropertiesComplete is false.",
  "events": [
    {
      "name": "spui-dismiss",
      "detailProperties": [
        "label",
        "originalEvent",
        "value"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    },
    {
      "name": "spui-selection-change",
      "detailProperties": [
        "event",
        "selectedValues",
        "type",
        "value"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    },
    {
      "name": "spui-tag-dismiss",
      "detailProperties": [
        "sourceEvent",
        "value"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    },
    {
      "name": "spui-tag-select",
      "detailProperties": [
        "originalEvent",
        "selected",
        "value"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    }
  ]
}
