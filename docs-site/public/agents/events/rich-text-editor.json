{
  "module": "rich-text-editor",
  "scope": "Events are listed by source module because a module can define a parent and its child tags. Check event.target when a module composes multiple tags; detailProperties lists statically declared top-level keys and may be incomplete when detailPropertiesComplete is false.",
  "events": [
    {
      "name": "spui-change",
      "detailProperties": [
        "value"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    },
    {
      "name": "spui-image-upload-error",
      "detailProperties": [
        "error",
        "fileName"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    },
    {
      "name": "spui-input",
      "detailProperties": [
        "value"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    },
    {
      "name": "spui-link-picker-error",
      "detailProperties": [
        "error"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    }
  ]
}
