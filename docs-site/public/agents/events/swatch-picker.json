{
  "module": "swatch-picker",
  "scope": "Events are listed by source module because a module can define a parent and its child tags. Check event.target when a module composes multiple tags; detailProperties lists statically declared top-level keys and may be incomplete when detailPropertiesComplete is false.",
  "events": [
    {
      "name": "spui-empty-swatch-activate",
      "detailProperties": [],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    },
    {
      "name": "spui-selection-change",
      "detailProperties": [
        "event",
        "selectedColor",
        "selectedColors",
        "selectedSwatch",
        "selectedValue",
        "selectedValues",
        "selectionMode",
        "type"
      ],
      "detailPropertiesComplete": true,
      "bubbles": "always",
      "composed": "always"
    },
    {
      "name": "spui-swatch-select",
      "detailProperties": [
        "color",
        "originalEvent",
        "value"
      ],
      "detailPropertiesComplete": false,
      "bubbles": "always",
      "composed": "always"
    }
  ]
}
