{
  "package": "@spfx-fast/sharepoint-ui",
  "component": {
    "react": "DialogTitle",
    "tag": "spui-dialog-title",
    "define": "defineDialogTitle",
    "module": "dialog",
    "category": "overlays",
    "api": {
      "reactSignature": "{ children, action, style, ...props }: DialogTitleProps",
      "callbackProps": [],
      "slots": [
        "default",
