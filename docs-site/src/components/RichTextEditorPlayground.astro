---
import ComponentPreviewRuntime from "./ComponentPreviewRuntime.astro";
---

<div class="component-demo rich-text-playground" data-component-demo data-default-appearance="ios" data-label="Rich text editor">
  <div class="component-demo__toolbar">
    <label>Appearance <select data-preview-appearance aria-label="Preview appearance"><option value="ios" selected>iOS</option><option value="fluent">Fluent</option><option value="windows">Windows</option><option value="linux">Linux</option><option value="glass">Glass</option></select></label>
    <label>Theme <select data-preview-theme aria-label="Preview SharePoint theme"><option value="sharepoint" selected>SharePoint teal</option><option value="blue">Blue</option><option value="green">Green</option><option value="pink">Pink</option><option value="custom">Custom</option></select></label>
    <label>Accent <input data-preview-accent type="color" value="#007780" aria-label="Preview accent color" /></label>
  </div>

  <div class="component-demo__stage rich-text-playground__stage">
    <div class="rich-text-playground__tabs" role="tablist" aria-label="Rich text editor example">
      <button id="rich-editor-tab" type="button" role="tab" aria-selected="true" aria-controls="rich-editor-panel" tabindex="0">Editor</button>
      <button id="rich-html-tab" type="button" role="tab" aria-selected="false" aria-controls="rich-html-panel" tabindex="-1">HTML source</button>
    </div>

    <section id="rich-editor-panel" class="rich-text-playground__panel" role="tabpanel" aria-labelledby="rich-editor-tab" tabindex="0">
      <spui-rich-text-editor id="rich-editor-demo" label="Project notes" value="&lt;p&gt;Quarterly review: &lt;strong&gt;in progress&lt;/strong&gt;.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Confirm owners&lt;/li&gt;&lt;li&gt;Set the review date&lt;/li&gt;&lt;/ul&gt;"></spui-rich-text-editor>
      <p class="rich-text-playground__hint">Format the note. Switch to HTML source to inspect or edit its sanitized value.</p>
    </section>

    <section id="rich-html-panel" class="rich-text-playground__panel" role="tabpanel" aria-labelledby="rich-html-tab" tabindex="0" hidden>
      <label class="rich-text-playground__label" for="rich-html-source">Edit the HTML value</label>
      <textarea id="rich-html-source" data-html-source spellcheck="false" aria-label="Edit the rich text editor HTML source"></textarea>
      <div class="rich-text-playground__rendered">
        <p class="rich-text-playground__label">Sanitized value from the editor</p>
        <pre><code id="rich-html-rendered"></code></pre>
      </div>
      <p class="rich-text-playground__hint">Changes are sanitized by the library and appear in the Editor tab. Markup is displayed as text here; it is never injected into the page.</p>
    </section>
  </div>

  <div class="component-demo__token-readout" data-preview-tokens aria-label="Applied theme token values"></div>
  <output class="component-demo__status" aria-live="polite">Edit the component or HTML source to see the current value.</output>
</div>

<ComponentPreviewRuntime />

<script>
  const playgrounds = document.querySelectorAll<HTMLElement>(".rich-text-playground");
  for (const playground of playgrounds) {
    const editor = playground.querySelector<HTMLElement & { value: string }>("#rich-editor-demo");
    const source = playground.querySelector<HTMLTextAreaElement>("#rich-html-source");
    const rendered = playground.querySelector<HTMLElement>("#rich-html-rendered");
    const tabs = [...playground.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    if (!editor || !source || !rendered || tabs.length !== 2) continue;

    const syncSource = () => {
      const value = editor.value;
      source.value = value;
      rendered.textContent = value;
    };
    const updateFromSource = () => {
      editor.value = source.value;
      syncSource();
    };
    const selectTab = (tab: HTMLButtonElement) => {
      for (const candidate of tabs) {
        const selected = candidate === tab;
        candidate.setAttribute("aria-selected", String(selected));
        candidate.tabIndex = selected ? 0 : -1;
        const panel = playground.querySelector<HTMLElement>(`#${candidate.getAttribute("aria-controls")}`);
        if (panel) panel.hidden = !selected;
      }
      tab.focus();
    };

    void customElements.whenDefined("spui-rich-text-editor").then(syncSource);
    editor.addEventListener("spui-input", syncSource);
    source.addEventListener("input", updateFromSource);
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", event => {
        if (!(event instanceof KeyboardEvent)) return;
        const nextIndex = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : event.key === "ArrowRight" ? (index + 1) % tabs.length : event.key === "ArrowLeft" ? (index - 1 + tabs.length) % tabs.length : -1;
        if (nextIndex < 0) return;
        event.preventDefault();
        selectTab(tabs[nextIndex]);
      });
    });
  }
</script>

<style>
  .rich-text-playground__stage {
    display: grid;
    width: 100%;
    min-width: 0;
    align-content: start;
    overflow: visible;
  }

  .rich-text-playground__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    width: 100%;
    border-bottom: 1px solid var(--spui-ui-stroke, var(--sl-color-hairline));
  }

  .rich-text-playground__tabs button {
    min-height: 2.6rem;
    padding: 0.5rem 0.85rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--spui-ui-muted, var(--sl-color-gray-2));
    font: inherit;
    cursor: pointer;
  }

  .rich-text-playground__tabs button[aria-selected="true"] {
    border-bottom-color: var(--spui-ui-accent, var(--sl-color-accent));
    color: var(--spui-ui-text, var(--sl-color-text));
    font-weight: 650;
  }

  .rich-text-playground__tabs button:focus-visible,
  .rich-text-playground__panel:focus-visible {
    outline: 2px solid var(--spui-focus-ring, var(--spui-ui-accent, var(--sl-color-accent)));
    outline-offset: 2px;
  }

  .rich-text-playground__panel {
    display: grid;
    width: 100%;
    min-width: 0;
    gap: 0.85rem;
    align-content: start;
  }

  .rich-text-playground__panel[hidden] {
    display: none;
  }

  .rich-text-playground__panel > spui-rich-text-editor {
    display: block;
    width: 100%;
  }

  .rich-text-playground__label {
    margin: 0;
    color: var(--spui-ui-text, var(--sl-color-text));
    font-size: 0.88rem;
    font-weight: 620;
  }

  .rich-text-playground__panel textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 10rem;
    padding: 0.8rem;
    border: 1px solid var(--spui-control-border, var(--spui-ui-stroke, var(--sl-color-hairline)));
    border-radius: var(--spui-control-radius, 0.6rem);
    background: var(--spui-control-background, var(--spui-ui-surface, var(--sl-color-bg)));
    color: var(--spui-ui-text, var(--sl-color-text));
    font: 0.9rem/1.55 var(--sl-font-mono);
    resize: vertical;
  }

  .rich-text-playground__panel textarea:focus-visible {
    outline: 2px solid var(--spui-focus-ring, var(--spui-ui-accent, var(--sl-color-accent)));
    outline-offset: 2px;
  }

  .rich-text-playground__rendered pre {
    max-height: 14rem;
    overflow: auto;
    margin: 0;
    padding: 0.8rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--sl-color-bg) 82%, var(--sl-color-bg-sidebar));
    color: var(--sl-color-text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .rich-text-playground__hint {
    margin: 0;
    color: var(--spui-ui-muted, var(--sl-color-gray-2));
    font-size: 0.84rem;
    line-height: 1.55;
  }
</style>
