<section class="copilot-demo" id="copilot-demo" lang="en" dir="ltr" data-display-mode="inline" aria-label="Interactive Copilot access review demonstration">
  <header class="copilot-demo__topbar">
    <div class="copilot-demo__brand">
      <svg class="copilot-demo__spark" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 1.5 14.8 9.2 22.5 12l-7.7 2.8L12 22.5l-2.8-7.7L1.5 12l7.7-2.8L12 1.5Z" fill="currentColor"/></svg>
      <strong>Microsoft 365 Copilot</strong>
      <span class="copilot-demo__slash" aria-hidden="true">/</span>
      <span>Access Review Agent</span>
    </div>
    <div class="copilot-demo__controls" aria-label="Preview controls">
      <spui-button id="copilot-theme" appearance="subtle" size="small">Change theme</spui-button>
      <spui-button id="copilot-direction" appearance="subtle" size="small" aria-pressed="false">Toggle RTL layout</spui-button>
      <spui-button id="copilot-expand" appearance="secondary" size="small" aria-pressed="false">Expand view</spui-button>
    </div>
  </header>

  <div class="copilot-demo__conversation">
    <div class="copilot-demo__welcome">
      <svg class="copilot-demo__welcome-mark" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 1.5 14.8 9.2 22.5 12l-7.7 2.8L12 22.5l-2.8-7.7L1.5 12l7.7-2.8L12 1.5Z" fill="currentColor"/></svg>
      <h2>Access review, ready for action.</h2>
      <p>Ask your agent for a SharePoint task. Review the returned view inline, or expand it to work through the details.</p>
    </div>

    <div class="copilot-demo__user-message">
      <p>Show the open access reviews. Let me approve one here.</p>
    </div>

    <div class="copilot-demo__agent-message">
      <svg class="copilot-demo__agent-mark" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 1.5 14.8 9.2 22.5 12l-7.7 2.8L12 22.5l-2.8-7.7L1.5 12l7.7-2.8L12 1.5Z" fill="currentColor"/></svg>
      <div>
        <strong>Access Review Agent</strong>
        <p>I found three open reviews. Two are ready to review; one needs owner confirmation. Check the scope, then choose an action.</p>
      </div>
    </div>

    <section class="copilot-demo__workspace" aria-label="Access reviews from Contoso Operations">
      <header class="copilot-demo__workspace-heading">
        <div>
          <p class="copilot-demo__eyebrow">CONTOSO OPERATIONS · SHAREPOINT</p>
          <h3>Access reviews <spui-badge color="informative" size="small">3 due</spui-badge></h3>
        </div>
        <spui-tag size="small" color="informative">Quarterly cycle · Q4</spui-tag>
      </header>

      <div class="copilot-demo__summary" aria-label="Review totals">
        <div><strong id="copilot-open-count">3</strong><span>Open reviews</span></div>
        <div><strong>2</strong><span>Ready to review</span></div>
        <div><strong>1</strong><span>Needs owner</span></div>
      </div>

      <spui-search-box id="copilot-search" label="Find a review" placeholder="Search reviews" clear-label="Clear search"></spui-search-box>

      <div class="copilot-demo__review-list" id="copilot-review-list">
        <spui-view-card class="copilot-demo__review" data-search="quarterly access review taylor chen external guests" kind="approval" title="Quarterly access review" subtitle="Taylor Chen · External guests" description="Confirm access for external guests before the quarterly audit.">
          <spui-avatar slot="leading" name="Taylor Chen" initials="TC" size="36" decorative></spui-avatar>
          <spui-tag slot="status" size="small" color="warning">Needs review</spui-tag>
          <div class="copilot-demo__scope"><span>Scope</span><strong>8 guests · 2 sites</strong></div>
          <spui-button slot="actions" appearance="primary" size="small" data-decision="approve">Approve</spui-button>
          <spui-button slot="actions" appearance="secondary" size="small" data-decision="details">Review details</spui-button>
        </spui-view-card>

        <spui-view-card class="copilot-demo__review" data-search="finance workspace alex chen membership changes" kind="approval" title="Finance workspace" subtitle="Alex Chen · Membership review" description="Review membership changes for the Finance workspace.">
          <spui-avatar slot="leading" name="Alex Chen" initials="AC" size="36" decorative></spui-avatar>
          <spui-tag slot="status" size="small" color="informative">Ready to approve</spui-tag>
          <div class="copilot-demo__scope"><span>Scope</span><strong>4 members · 1 group</strong></div>
          <spui-button slot="actions" appearance="primary" size="small" data-decision="approve">Approve</spui-button>
          <spui-button slot="actions" appearance="secondary" size="small" data-decision="details">Review details</spui-button>
        </spui-view-card>

        <spui-view-card class="copilot-demo__review" data-search="project atlas access request priya shah" kind="approval" title="Project Atlas access" subtitle="Priya Shah · Role change" description="Check a requested role change for the project site.">
          <spui-avatar slot="leading" name="Priya Shah" initials="PS" size="36" decorative></spui-avatar>
          <spui-tag slot="status" size="small" color="danger">Owner confirmation</spui-tag>
          <div class="copilot-demo__scope"><span>Scope</span><strong>1 role change · 1 site</strong></div>
          <spui-button slot="actions" appearance="primary" size="small" data-decision="approve">Approve</spui-button>
          <spui-button slot="actions" appearance="secondary" size="small" data-decision="details">Review details</spui-button>
        </spui-view-card>
      </div>

      <footer class="copilot-demo__workspace-footer">
        <spui-button id="copilot-context" appearance="secondary" size="small">Share this view with Copilot</spui-button>
        <span class="copilot-demo__demo-note"><span aria-hidden="true">●</span> Demo data · actions stay on this page</span>
      </footer>
    </section>

    <output class="copilot-demo__feedback" id="copilot-feedback" aria-live="polite">Choose an action to update this local preview.</output>
  </div>
</section>

<script>
  import { defineAvatar } from "@spfx-fast/sharepoint-ui/elements/avatar";
  import { defineBadge } from "@spfx-fast/sharepoint-ui/elements/badge";
  import { defineButton } from "@spfx-fast/sharepoint-ui/elements/button";
  import { defineSearchBox } from "@spfx-fast/sharepoint-ui/elements/search";
  import { defineTag } from "@spfx-fast/sharepoint-ui/elements/tags";
  import { defineViewCard } from "@spfx-fast/sharepoint-ui/elements/view-card";
  import { getSharePointUIStyleTokens } from "@spfx-fast/sharepoint-ui/appearance";
  import themeCapture from "../data/sharepoint-theme.json";
  import { createPreviewThemeOverrides } from "../utils/preview-theme.js";
  import { observeDocsPreviewColorScheme } from "../utils/docs-preview-theme.js";

  defineAvatar();
  defineBadge();
  defineButton();
  defineSearchBox();
  defineTag();
  defineViewCard();

  const demo = document.querySelector<HTMLElement>("#copilot-demo");
  const syncColorScheme = observeDocsPreviewColorScheme(demo);
  const accentColors = ["#007780", "#0f6cbd", "#107c10", "#c239b3"];
  const accentNames = ["SharePoint teal", "blue", "green", "pink"];
  const reviewCards = [...document.querySelectorAll<HTMLElement>(".copilot-demo__review")];
  const feedback = document.querySelector<HTMLOutputElement>("#copilot-feedback");
  const openCount = document.querySelector<HTMLElement>("#copilot-open-count");
  let accentIndex = 0;
  let approvedCount = 0;
  const setAccent = (accent: string) => {
    if (!demo) return;
    const overrides = createPreviewThemeOverrides(themeCapture.presets.sharepoint.tokens, accent, accent !== themeCapture.presets.sharepoint.accent);
    Object.entries(getSharePointUIStyleTokens("ios", overrides)).forEach(([name, value]) => demo.style.setProperty(name, value));
    Object.entries(overrides).forEach(([name, value]) => demo.style.setProperty(name, value));
    syncColorScheme();
  };
  setAccent(accentColors[0]);

  document.querySelector("#copilot-theme")?.addEventListener("click", () => {
    accentIndex = (accentIndex + 1) % accentColors.length;
    setAccent(accentColors[accentIndex]);
    if (feedback) feedback.textContent = `Preview theme changed to ${accentNames[accentIndex]}.`;
  });

  document.querySelector("#copilot-direction")?.addEventListener("click", event => {
    if (!demo) return;
    const button = event.currentTarget as HTMLElement;
    const rtl = demo.dir !== "rtl";
    demo.dir = rtl ? "rtl" : "ltr";
    button.setAttribute("aria-pressed", String(rtl));
    if (feedback) feedback.textContent = rtl ? "Right-to-left layout is active. Production locale comes from the Copilot host." : "Left-to-right layout is active.";
  });

  document.querySelector("#copilot-expand")?.addEventListener("click", event => {
    if (!demo) return;
    const button = event.currentTarget as HTMLElement;
    const expanded = demo.dataset.displayMode !== "fullscreen";
    demo.dataset.displayMode = expanded ? "fullscreen" : "inline";
    button.setAttribute("aria-pressed", String(expanded));
    button.textContent = expanded ? "Return inline" : "Expand view";
    if (feedback) feedback.textContent = expanded ? "Expanded display mode preview." : "Returned to inline display mode preview.";
  });

  document.querySelector("#copilot-search")?.addEventListener("spui-input", event => {
    const query = String((event as CustomEvent<{ value?: string }>).detail?.value ?? "").trim().toLocaleLowerCase();
    let visible = 0;
    for (const card of reviewCards) {
      card.hidden = !card.dataset.search?.toLocaleLowerCase().includes(query);
      if (!card.hidden) visible++;
    }
    if (feedback) feedback.textContent = query ? `${visible} matching review${visible === 1 ? "" : "s"}.` : "Showing all three access reviews.";
  });

  document.querySelectorAll<HTMLElement>("[data-decision]").forEach(button => button.addEventListener("click", () => {
    const card = button.closest<HTMLElement>(".copilot-demo__review");
    if (!card || !feedback) return;
    if (button.dataset.decision === "details") {
      feedback.textContent = `Details opened for ${card.getAttribute("title")}. The host app would load the authorized SharePoint item here.`;
      return;
    }
    const status = card.querySelector<HTMLElement>("spui-tag[slot=status]");
    const approve = card.querySelector<HTMLElement>('[data-decision="approve"]');
    if (status) {
      status.textContent = "Approved in preview";
      status.setAttribute("color", "success");
    }
    approve?.setAttribute("disabled", "");
    approvedCount++;
    if (openCount) openCount.textContent = String(Math.max(0, reviewCards.length - approvedCount));
    feedback.textContent = `${card.getAttribute("title")} marked approved in this preview only. A real component must persist and confirm the SharePoint update.`;
  }));

  document.querySelector("#copilot-context")?.addEventListener("click", () => {
    if (!feedback) return;
    const open = [...document.querySelectorAll<HTMLElement>(".copilot-demo__review:not([hidden])")].filter(card => !card.querySelector('[data-decision="approve"]')?.hasAttribute("disabled")).length;
    feedback.textContent = `Context preview: ${open} open access reviews are visible. Real SPFx code sends a concise authorized summary with copilotBridge.updateModelContextAsync.`;
  });
</script>

<style>
  .copilot-demo {
    --copilot-border: var(--spui-ui-stroke, #d5e6e7);
    --copilot-muted: var(--spui-ui-muted, #5b6268);
    --copilot-surface: var(--spui-ui-surface, #fff);
    --copilot-canvas: var(--spui-ui-canvas, #f6f8fa);
    color: var(--spui-ui-text, #242424);
    font-family: var(--spui-font-family, inherit);
    border: 1px solid var(--copilot-border);
    border-radius: 1.15rem;
    background: var(--copilot-canvas);
    box-shadow: 0 18px 50px color-mix(in srgb, var(--spui-ui-accent, #007780) 12%, transparent);
    overflow: hidden;
  }

  .copilot-demo__topbar {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid var(--copilot-border);
    background: var(--copilot-surface);
  }

  .copilot-demo__brand,
  .copilot-demo__controls,
  .copilot-demo__workspace-heading,
  .copilot-demo__workspace-footer,
  .copilot-demo__agent-message {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .copilot-demo__brand { min-width: 0; font-size: 0.8rem; }
  .copilot-demo__brand strong { white-space: nowrap; }
  .copilot-demo__slash { color: var(--copilot-muted); }
  .copilot-demo__spark,
  .copilot-demo__welcome-mark,
  .copilot-demo__agent-mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    padding: 0.35rem;
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--spui-ui-accent, #007780) 14%, var(--copilot-surface));
    color: var(--spui-ui-accent, #007780);
    font-size: 1.1rem;
    font-weight: 700;
  }
  .copilot-demo__controls { flex: none; gap: 0.35rem; }

  .copilot-demo__conversation {
    display: grid;
    width: min(100% - 2rem, 52rem);
    gap: 1.25rem;
    margin-inline: auto;
    padding: clamp(1.25rem, 4vw, 2.5rem) 0 2rem;
  }

  .copilot-demo__welcome { text-align: start; }
  .copilot-demo__welcome-mark { width: 2.5rem; height: 2.5rem; margin: 0 0 0.8rem; border-radius: 50%; }
  .copilot-demo__welcome h2 { max-width: 30ch; margin: 0; font-size: clamp(1.45rem, 3.2vw, 2rem); letter-spacing: -0.025em; }
  .copilot-demo__welcome p { max-width: 48ch; margin: 0.55rem 0 0; color: var(--copilot-muted); line-height: 1.55; }
  .copilot-demo__user-message {
    justify-self: end;
    max-width: 85%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--copilot-border);
    border-radius: 1rem 1rem 0.25rem 1rem;
    background: var(--copilot-surface);
  }
  .copilot-demo__user-message p { margin: 0; line-height: 1.45; }
  .copilot-demo__agent-message { align-items: flex-start; }
  .copilot-demo__agent-mark { background: var(--spui-ui-accent, #007780); color: var(--spui-ui-accent-text, white); }
  .copilot-demo__agent-message strong { font-size: 0.84rem; }
  .copilot-demo__agent-message p { margin: 0.25rem 0 0; color: var(--copilot-muted); line-height: 1.5; }

  .copilot-demo__workspace {
    display: grid;
    gap: 0.9rem;
    padding: clamp(0.9rem, 3vw, 1.35rem);
    border: 1px solid var(--copilot-border);
    border-radius: 1rem;
    background: var(--copilot-surface);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--spui-ui-accent, #007780) 8%, transparent);
  }
  .copilot-demo__workspace-heading { justify-content: space-between; gap: 1rem; }
  .copilot-demo__eyebrow { margin: 0 0 0.25rem; color: var(--copilot-muted); font-size: 0.64rem; font-weight: 700; letter-spacing: 0.08em; }
  .copilot-demo__workspace-heading h3 { display: flex; align-items: center; gap: 0.55rem; margin: 0; font-size: 1.15rem; }
  .copilot-demo__summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.55rem; }
  .copilot-demo__summary > div { display: grid; gap: 0.1rem; padding: 0.65rem 0.75rem; border: 1px solid var(--copilot-border); border-radius: 0.7rem; background: var(--copilot-canvas); }
  .copilot-demo__summary strong { font-size: 1.15rem; }
  .copilot-demo__summary span { color: var(--copilot-muted); font-size: 0.73rem; }
  .copilot-demo__review-list { display: grid; gap: 0.65rem; }
  .copilot-demo__review { min-width: 0; }
  .copilot-demo__review::part(surface) { gap: 0.55rem; padding: 0.85rem; border-radius: 0.8rem; box-shadow: none; }
  .copilot-demo__review::part(title) { font-size: 0.98rem; }
  .copilot-demo__review::part(description) { color: var(--copilot-muted); font-size: 0.82rem; }
  .copilot-demo__review::part(actions) { flex-wrap: wrap; }
  .copilot-demo__scope { display: flex; justify-content: space-between; gap: 0.8rem; padding-top: 0.45rem; border-top: 1px solid var(--copilot-border); font-size: 0.75rem; }
  .copilot-demo__scope span { color: var(--copilot-muted); }
  .copilot-demo__workspace-footer { justify-content: space-between; flex-wrap: wrap; padding-top: 0.25rem; }
  .copilot-demo__demo-note { color: var(--copilot-muted); font-size: 0.7rem; }
  .copilot-demo__demo-note span { color: var(--spui-ui-accent, #007780); font-size: 0.6rem; }
  .copilot-demo__feedback { min-height: 1.3rem; color: var(--copilot-muted); font-size: 0.8rem; }

  .copilot-demo[data-display-mode="fullscreen"] {
    position: fixed;
    z-index: 10000;
    inset: 0.75rem;
    overflow: auto;
    border-radius: 1.25rem;
    box-shadow: 0 28px 100px rgb(0 0 0 / 35%);
  }
  .copilot-demo[data-display-mode="fullscreen"] .copilot-demo__conversation { width: min(100% - 2rem, 65rem); }
  .copilot-demo spui-search-box { display: block; width: 100%; }
  .copilot-demo [hidden] { display: none !important; }

  @media (max-width: 700px) {
    .copilot-demo__topbar { align-items: flex-start; flex-direction: column; }
    .copilot-demo__controls { width: 100%; flex-wrap: wrap; }
    .copilot-demo__conversation { width: min(100% - 1.25rem, 52rem); }
    .copilot-demo__workspace-heading { align-items: flex-start; flex-direction: column; }
    .copilot-demo__summary > div { padding-inline: 0.55rem; }
    .copilot-demo__summary span { font-size: 0.65rem; }
    .copilot-demo__workspace-footer { align-items: flex-start; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .copilot-demo *, .copilot-demo *::before, .copilot-demo *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
  }
</style>
