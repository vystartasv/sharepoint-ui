<section class="preview-bench" aria-label="Live SharePoint UI component preview">
  <div class="preview-copy">
    <h2>Built for the page you already have.</h2>
    <p>Controls inherit the active SharePoint palette and keep their layout inside the section that hosts them.</p>
    <div class="preview-actions">
      <spui-button appearance="primary" id="preview-save">Save update</spui-button>
      <spui-button appearance="secondary" id="preview-theme">Change accent</spui-button>
    </div>
  </div>
  <div class="preview-surface" id="preview-surface">
    <div class="preview-toolbar">
      <span class="preview-dot" aria-hidden="true"></span>
      <span>Request review</span>
      <spui-tag appearance="brand" size="small">In progress</spui-tag>
    </div>
    <label class="preview-field-label" for="preview-title">Work item</label>
    <spui-input id="preview-title" aria-label="Work item" value="Quarterly access review" size="medium"></spui-input>
    <div class="preview-status">
      <spui-badge appearance="tint" color="success">Ready for review</spui-badge>
      <span>Updated just now</span>
    </div>
    <output id="preview-message" class="preview-message" aria-live="polite">iOS appearance · stone accent</output>
  </div>
</section>

<script>
  import { defineBadge, defineButton, defineInput, defineTag } from "@spfx-fast/sharepoint-ui/elements";
  import { getSharePointUIStyleTokens } from "@spfx-fast/sharepoint-ui/appearance";

  defineBadge();
  defineButton();
  defineInput();
  defineTag();

  const preview = document.querySelector<HTMLElement>("#preview-surface");
  const accents = ["#78716c", "#0078d4", "#138a58", "#c23b8d"];
  let accentIndex = 0;
  if (preview) Object.entries(getSharePointUIStyleTokens("ios", { "--spui-ui-accent": accents[accentIndex] })).forEach(([name, value]) => preview.style.setProperty(name, value));

  const previewMessage = document.querySelector<HTMLOutputElement>("#preview-message");
  document.querySelector("#preview-save")?.addEventListener("click", () => {
    if (previewMessage) previewMessage.textContent = "Your update is ready to save.";
  });
  document.querySelector("#preview-theme")?.addEventListener("click", () => {
    if (preview) {
      accentIndex = (accentIndex + 1) % accents.length;
      const tokens = getSharePointUIStyleTokens("ios", { "--spui-ui-accent": accents[accentIndex] });
      Object.entries(tokens).forEach(([name, value]) => preview.style.setProperty(name, value));
      if (previewMessage) previewMessage.textContent = `iOS appearance · accent ${accents[accentIndex]}`;
    }
  });
</script>
